@'
# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
kubeconfig
kubeconfig.*
*.kubeconfig

# Node.js
node_modules/
dist/
coverage/
npm-debug.log*

# Python
__pycache__/
.venv/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
'@ | Set-Content -Path ".gitignore" -Encoding utf8